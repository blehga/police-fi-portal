{
  "name": "police-fi-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npm run prisma:generate:platform && next build",
    "start": "next start",
    "lint": "eslint",
    "prisma:generate": "prisma generate",
    "prisma:generate:platform": "prisma generate --schema=prisma/platform/schema.prisma",
    "prisma:reset": "prisma db push --force-reset && prisma generate && npm run prisma:seed",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed:platform": "tsx prisma/platform/seed.ts",
    "prisma:seed:all": "npm run prisma:seed && npm run prisma:seed:platform"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-mariadb": "^7.7.0",
    "@prisma/client": "^6.19.3",
    "@tiptap/extension-color": "^3.22.3",
    "@tiptap/extension-list-item": "^3.22.3",
    "@tiptap/extension-text-align": "^3.22.3",
    "@tiptap/extension-text-style": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "mariadb": "^3.5.2",
    "mysql2": "^3.20.0",
    "next": "^15.5.12",
    "next-auth": "^4.24.11",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.41.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
