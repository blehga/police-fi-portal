generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/platform-client"
}

datasource db {
  provider = "mysql"
  url      = env("PLATFORM_DATABASE_URL")
}

model organization_databases {
  id              BigInt        @id @default(autoincrement())
  organization_id BigInt
  database_name   String        @db.VarChar(255)
  host            String        @db.VarChar(255)
  port            Int           @default(3306)
  username        String        @db.VarChar(255)
  password        String        @db.VarChar(255)
  status          String        @default("active") @db.VarChar(50)
  created_at      DateTime?     @default(now()) @db.Timestamp(0)
  updated_at      DateTime?     @default(now()) @db.Timestamp(0)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_org_db_org")

  @@index([organization_id], map: "fk_org_db_org")
}

model organization_subscriptions {
  id                   BigInt             @id @default(autoincrement())
  organization_id      BigInt
  subscription_plan_id BigInt
  status               String             @default("active") @db.VarChar(50)
  start_date           DateTime?          @db.DateTime(0)
  end_date             DateTime?          @db.DateTime(0)
  created_at           DateTime?          @default(now()) @db.Timestamp(0)
  updated_at           DateTime?          @default(now()) @db.Timestamp(0)
  organizations        organizations      @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_org_subs_org")
  subscription_plans   subscription_plans @relation(fields: [subscription_plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_org_subs_plan")

  @@index([organization_id], map: "fk_org_subs_org")
  @@index([subscription_plan_id], map: "fk_org_subs_plan")
}

model organizations {
  id                         BigInt                       @id @default(autoincrement())
  name                       String                       @db.VarChar(255)
  slug                       String                       @unique(map: "slug") @db.VarChar(100)
  type                       String?                      @db.VarChar(50)
  status                     String                       @default("pending") @db.VarChar(50)
  created_at                 DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(0)
  organization_databases     organization_databases[]
  organization_subscriptions organization_subscriptions[]
}

model subscription_plans {
  id                         BigInt                       @id @default(autoincrement())
  name                       String                       @db.VarChar(100)
  code                       String                       @unique(map: "code") @db.VarChar(50)
  max_users                  Int                          @default(0)
  features_json              Json?
  created_at                 DateTime?                    @default(now()) @db.Timestamp(0)
  updated_at                 DateTime?                    @default(now()) @db.Timestamp(0)
  organization_subscriptions organization_subscriptions[]
}
